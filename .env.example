# Copie para .env e ajuste. Nunca suba o .env para o Git.

# Banco (valores do docker-compose.yml)
DATABASE_URL=mysql+pymysql://hackathon:hackathon@127.0.0.1:3306/hackathon

# Chave exigida no header X-API-Key do webhook e dos endpoints
API_KEY=troque-esta-chave

# LLM (DeepSeek). Sem chave, o sistema usa o plano B por regras (origem=fallback)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=15
# Few-shot dinâmico (ADR-014): tickets revisados parecidos que vão como exemplo (0 desliga) e similaridade mínima
FEWSHOT_K=4
FEWSHOT_SIM_MIN=0.45

# Áudio e foto do cliente (ADR-015): o Gemini transcreve o áudio e descreve a foto antes da triagem.
# Chave em https://aistudio.google.com/apikey. Sem chave, a mídia fica guardada e o ticket segue só com o texto.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
MIDIA_TIMEOUT_SECONDS=60

# Embeddings: "onnx" (modelo multilíngue int8, sem PyTorch), "sbert" (mesmo modelo via PyTorch, instale sentence-transformers) ou "hash" (só testes)
EMBEDDING_BACKEND=onnx
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Usado pelo simulador e pelo painel
API_URL=http://127.0.0.1:8000

# --- Canais reais (opcionais) ---
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_POLL_SECONDS=30
