# Copie para .env.production e preencha. NUNCA suba o .env.production para o Git.
# Gere segredos com: openssl rand -hex 24   (use só letras e números: a senha do MySQL entra numa URL)

DOMAIN=triagem.seudominio.com

MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# Chave dos canais/integrações (header X-API-Key); é também a chave de acesso ao painel
API_KEY=

# LLM (sem chave, a triagem usa só o plano B por regras)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Limites do formulário público (protegem o custo do LLM)
PUBLIC_RATE_PER_IP_MIN=5
PUBLIC_RATE_GLOBAL_MIN=60

# --- Canais reais (opcionais) ---
# WhatsApp (Meta Cloud API): verify token = texto que você inventa e cola no painel da Meta; app secret = "Segredo do app"
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_APP_SECRET=
# E-mail (IMAP) - suba com --profile email. Use SENHA DE APP, nunca a senha principal.
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=
IMAP_POLL_SECONDS=30
